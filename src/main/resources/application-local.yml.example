spring:
  config:
    activate:
      on-profile: local
  datasource:
    url: jdbc:mysql://127.0.0.1:3307/token_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
    username: token_user
    password: token_pass
  jpa:
    hibernate:
      ddl-auto: update
  cloud:
    discovery:
      enabled: false
  kafka:
    listener:
      auto-startup: false

server:
  address: ${SERVER_ADDRESS:127.0.0.1}
  port: ${SERVER_PORT:8084}

eureka:
  client:
    enabled: false
    register-with-eureka: false
    fetch-registry: false

token:
  kafka:
    consumer-enabled: false
  outbox:
    enabled: false
