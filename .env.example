# Production template for env/token.env.
# Copy this file on the deployment server and replace every CHANGE_ME value.
# Docker service names below must match the production Compose network.

# Application
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8084
DEPLOY_MARKER=planwith-fo-token-production
GATEWAY_PUBLIC_URL=/
SPRINGDOC_SWAGGER_UI_ENABLED=false
TOKEN_GATEWAY_AUTH_ENABLED=true

# MySQL
DB_URL=jdbc:mysql://mysql:3306/token_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=CHANGE_ME_TOKEN_DB_USERNAME
DB_PASSWORD=CHANGE_ME_TOKEN_DB_PASSWORD
JPA_DDL_AUTO=update

# Eureka
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://discovery:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=token-service
TOKEN_KAFKA_CONSUMER_ENABLED=true
TOKEN_TOPIC_PAYMENT_COMPLETED=planwith.payment.completed
TOKEN_TOPIC_GRADE_REWARD_GRANTED=planwith.grade.reward-granted
TOKEN_TOPIC_GRADE_INITIAL_BONUS_GRANTED=planwith.grade.initial-bonus-granted
TOKEN_TOPIC_TOKEN_CHARGED=planwith.token.charged
TOKEN_TOPIC_TOKEN_USED=planwith.token.used
TOKEN_TOPIC_TOKEN_REWARDED=planwith.token.rewarded
TOKEN_TOPIC_TOKEN_EXPIRED=planwith.token.expired
TOKEN_TOPIC_TOKEN_CHARGE_FAILED=planwith.token.charge-failed

# Transactional Outbox
TOKEN_OUTBOX_ENABLED=true
TOKEN_OUTBOX_RELAY_BATCH_SIZE=50
TOKEN_OUTBOX_RELAY_INTERVAL=5s
TOKEN_OUTBOX_RELAY_INITIAL_DELAY=5s
TOKEN_OUTBOX_SEND_TIMEOUT=10s
TOKEN_OUTBOX_MAX_RETRY=10
TOKEN_OUTBOX_BACKOFF_INITIAL=5s
TOKEN_OUTBOX_BACKOFF_MULTIPLIER=2
TOKEN_OUTBOX_BACKOFF_MAX=5m

# Charge reconciliation
TOKEN_CHARGE_RECONCILE_ENABLED=true
TOKEN_CHARGE_RECONCILE_BATCH_SIZE=50
TOKEN_CHARGE_RECONCILE_STALE_AFTER=5m
TOKEN_CHARGE_RECONCILE_INTERVAL=1m
TOKEN_CHARGE_RECONCILE_INITIAL_DELAY=30s
TOKEN_CHARGE_RECONCILE_MAX_RETRY=10

# PortOne
PORTONE_STUB_ENABLED=false
PORTONE_STORE_ID=CHANGE_ME_PORTONE_STORE_ID
PORTONE_CHANNEL_KEY=CHANGE_ME_PORTONE_CHANNEL_KEY
PORTONE_API_SECRET=CHANGE_ME_PORTONE_API_SECRET
PORTONE_API_BASE_URL=https://api.portone.io